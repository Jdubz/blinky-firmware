# TFLite model binaries (the .h C header is tracked, the binary is not)
*.tflite

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
**/venv/

# CMake build directories for native harnesses (blinky_time's ml-training/analysis/run_parity_test.py builds tests/parity)
tests/parity/build/

# Compiled binaries (prevent accidental venv/library commits)
*.so
*.dylib
*.dll
*.whl
*.tar.gz
*.zip
# Exception: bootloader artifacts ship as DFU.zip; we want them in git
!bootloader/*.zip
*.onnx
*.pt
*.pth

# Node
node_modules/
dist/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Editor scratch logs
excalidraw.log
.claude/

# Local run artifacts (never source)
test-results/
previews/
.playwright-mcp/
scratch/

# Pinned, isolated firmware toolchain (scripts/setup_toolchain.sh, #252)
# The pinned toolchain: a directory here, or a link to a shared one (the test box links
# it into blinky_time's firmware/ submodule, blinky_time#357).
.arduino

# Local scratch: host-test build output and deep-research notes
/build/
/reports/
/research_notes/
