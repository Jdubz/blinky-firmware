# Line endings. The index is LF everywhere; these rules pin the working-copy
# endings that tools depend on, regardless of core.autocrlf (#199).

* text=auto

# Shell scripts and git hooks must be LF or sh/bash fails on `\r`.
*.sh text eol=lf
# Hooks have no extension (hooks/pre-push is a bash script copied into
# .git/hooks by scripts/install-hooks.sh).
hooks/** text eol=lf

# cmd.exe mis-parses labels/goto in LF-only batch files.
*.bat text eol=crlf
*.cmd text eol=crlf

# Patches: keep LF and never flag/strip their whitespace. A blank context
# line is " " and context mirrors the patched source's trailing whitespace.
*.patch text eol=lf -whitespace
